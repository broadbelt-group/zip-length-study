// General simulation parameters
T = 250		// temperature, deg C
total_chains = 1E5    	        // number of initial chains to simulate
repeat_unit_mass = 198.22       // molar mass of repeat unit (g/mol) - also the molar mass of the polymer
end_group_mass = 15.04          // molar mass of one end group (g/mol)
density = 0.005		// density of the polymer (g/mL or g/cm3)
Mn = 1210000			        // number-average molecular weight (g/mol)
Mw = 1815000			        // weight-average molecular weight (g/mol)
time = 61		// maximum simulation time (min)

// Kinetic parameters for all reactions
// Units: A [1/s or L/mol/s] and Ea [kcal/mol]
A_I = 1E16
Ea_I = 51 

A_D = 2.69E+11
Ea_D = 20.1

A_T = 1E9
Ea_T = 0

A_SR = 0
Ea_SR = 26
