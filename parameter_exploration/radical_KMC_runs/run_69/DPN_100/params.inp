// General simulation parameters (1503)
T = 139			// temperature, deg C
total_chains = 1e+06			// number of initial chains to simulate
repeat_unit_mass = 217			// molar mass of repeat unit (g/mol) - also the molar mass of the polymer
end_group_mass = 15.04          // molar mass of one end group (g/mol)
density = 0.008			// density of the polymer (g/mL or g/cm3)
Mn = 21727			// number-average molecular weight (g/mol)
Mw = 32591			// weight-average molecular weight (g/mol)
time = 60

// Kinetic parameters for all reactions
// Units: A [1/s or L/mol/s] and Ea [kcal/mol]
A_I = 1E16
Ea_I = 35.7

A_D = 4.1E+12
Ea_D = 17.3

A_T = 1E9
Ea_T = 0
